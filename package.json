{
  "name": "prueba-tecnic",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @app/web dev",
    "build": "pnpm --filter @app/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "arch:selftest": "bash scripts/arch-selftest.sh",
    "arch": "depcruise apps/web --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "audit": "pnpm audit --audit-level=high",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts",
    "db:seed-user": "node --env-file-if-exists=.env scripts/seed-demo-user.mts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.9.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.18.0"
}
