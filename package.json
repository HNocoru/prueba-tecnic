{
  "name": "prueba-tecnic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "arch:selftest": "bash scripts/arch-selftest.sh",
    "arch": "depcruise app modules shared components --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "audit": "pnpm audit --audit-level=high",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > shared/db/database.types.ts",
    "db:seed-user": "node --env-file-if-exists=.env scripts/seed-demo-user.mts",
    "meta:check": "node --env-file-if-exists=.env scripts/meta-check.mts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.124",
    "@ai-sdk/groq": "^4.0.86",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-virtual": "^3.14.28",
    "ai": "^7.0.179",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "libphonenumber-js": "^1.13.17",
    "livekit-server-sdk": "^2.20.1",
    "next": "16.4.6",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.18.0"
}
